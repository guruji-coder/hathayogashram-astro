---
import Layout from '../components/layout/Layout.astro';
import { pageSchemas } from '../schemas';

// Import all home page sections from centralized location
import {
  BestYogaSchool,
  CertificationsTextSection,
  FounderSection,
  HeroSection,
  LocationSection,
  ObjectiveTTC,
  ReviewSection,
  TeacherSection,
  TTCBlogs,
  TTCCourseCombo,
  YogaAllianceRegisteredSchool,
  YogaFacilities,
  YTTCourseSection,
 } from '$components/sections';
import {
  HOME_HERO,
  HOME_HIGHLIGHTS,
  HOME_CONTENT,
  HOME_GALLERY,
  HOME_COURSES,
  HOME_STYLES,
  OBJECTIVE_SECTION,
  TTC_COURSES_SECTION,
  CERTIFICATIONS_SECTION,
  FACILITIES_CARDS_SECTION,
  FOUNDER_SECTION,
} from '$constants/pages/home';

import { FAQ_SECTION, FAQ_STYLES } from '$constants/pages/home/faq';
import {
  TRAINING_200_BLOGS_SECTION,
  TRAINING_200_COMBO_SECTION,
} from '$constants/pages/ttc/200hour';
import { FaqSection, FAQFlipSection } from '$svelte/sections';
import { TEACHERS_SECTION } from '../constants';
// Generate schemas for home page
const homeSchemas = pageSchemas.home();
---

<Layout
  additionalSchemas={homeSchemas}
  canonical="https://hathayogashram.com/"
  description="Join authentic 200/300 hour Yoga Teacher Training in Rishikesh with Hatha Yogashram. Yoga Alliance RYS certified residential programs with Indian masters. Traditional Hatha & Ashtanga Yoga, Sanskrit mantras, philosophy from ancient texts."
  image="https://hathayogashram.com/yogaschoolpic.jpg"
  title="Best Yoga Teacher Training in Rishikesh, India - Hatha Yogashram"
>
  <HeroSection />

  <!-- Best Yoga School Section -->
  <BestYogaSchool
    content={HOME_CONTENT}
    courses={HOME_COURSES}
    gallery={HOME_GALLERY}
    hero={HOME_HERO}
    highlights={HOME_HIGHLIGHTS}
    styles={HOME_STYLES}
  />

  <!-- Objective + TTC Courses Section -->
  <ObjectiveTTC
    coursesSection={TTC_COURSES_SECTION}
    objective={OBJECTIVE_SECTION}
    styles={HOME_STYLES}
  />

  <!-- Certifications & Accreditations Section -->
  <CertificationsTextSection
    section={CERTIFICATIONS_SECTION}
    styles={HOME_STYLES}
  />

  <!-- Founder Section -->
  <FounderSection
    section={FOUNDER_SECTION}
    styles={HOME_STYLES}
  />
  <YTTCourseSection />

  <YogaAllianceRegisteredSchool />

  <ReviewSection />

  <TeacherSection teachersData={TEACHERS_SECTION} />

  <YogaFacilities section={FACILITIES_CARDS_SECTION} />

  <!-- TTC Blogs Section -->
  <TTCBlogs blogsData={TRAINING_200_BLOGS_SECTION} />

  <!-- Training Combo Section -->
  <TTCCourseCombo comboData={TRAINING_200_COMBO_SECTION} />

  <!-- Instagram Feed Section -->

  <!-- <FaqSection client:load sectionData={FAQ_SECTION} styles={FAQ_STYLES} /> -->

  <FAQFlipSection client:load />


  <!-- Location Section -->

  <LocationSection />
</Layout>
