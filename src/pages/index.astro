---
/**
 * HOME PAGE - Simplified Version
 * 
 * Reduced from 40+ imports to just 3 main imports.
 * Uses consolidated content and generic reusable components.
 */

import Layout from '../components/layout/Layout.astro';
import { pageSchemas } from '../schemas';
import { HOME_PAGE } from '../content/pages/home';
import Section from '../components/generic/Section.astro';
import Card from '../components/generic/Card.astro';

// Keep existing components that are already well-optimized
import {
  HeroSection,
  ReviewSection,
  LocationSection,
  YTTCourseSection,
  YogaAllianceRegisteredSchool,
} from '../components/sections';

import { FAQFlipSection } from '../components/svelte/sections';
import { TEACHERS_SECTION } from '../constants';

// Generate schemas for home page
const homeSchemas = pageSchemas.home();
---

<Layout
  additionalSchemas={homeSchemas}
  canonical={HOME_PAGE.seo.canonical}
  description={HOME_PAGE.seo.description}
  image={HOME_PAGE.seo.image}
  title={HOME_PAGE.seo.title}
>
  <!-- Hero Section -->
  <HeroSection />

  <!-- Best Yoga School Section -->
  <Section title="Welcome to Hatha Yogashram" bgColor="bg-gray-50">
    <!-- Highlights -->
    <div class="grid md:grid-cols-2 gap-6 mb-12">
      {HOME_PAGE.highlights.map((highlight) => (
        <div class="border-2 border-purple-900 bg-purple-50 p-6 rounded-lg flex items-center">
          <i class={`${highlight.icon} text-purple-900 text-2xl mr-4`}></i>
          <span class="text-sm font-semibold text-gray-800">{highlight.text}</span>
        </div>
      ))}
    </div>

    <!-- Content -->
    <div class="space-y-4">
      <p class="text-gray-700 leading-relaxed text-justify">
        {HOME_PAGE.content.intro}
      </p>
      {HOME_PAGE.content.paragraphs.map((paragraph) => (
        <p class="text-gray-700 leading-relaxed text-justify">{paragraph}</p>
      ))}
    </div>

    <!-- Course Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-8">
      {HOME_PAGE.courses.map((course) => (
        <a
          href={course.url}
          class="px-8 py-3 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors text-center font-semibold"
        >
          {course.title}
        </a>
      ))}
    </div>
  </Section>

  <!-- Objective Section -->
  <Section title={HOME_PAGE.objective.title} bgColor="bg-white">
    <div class="max-w-4xl mx-auto space-y-4">
      {HOME_PAGE.objective.paragraphs.map((paragraph) => (
        <p class="text-gray-700 leading-relaxed text-justify">{paragraph}</p>
      ))}

      <!-- Mantras -->
      <div class="my-8 p-6 bg-purple-50 rounded-lg">
        {HOME_PAGE.objective.mantras.map((mantra) => (
          <p class="text-lg mb-2">
            <span class="font-semibold text-purple-900">{mantra.sanskrit}</span>
            <span class="text-gray-700"> - {mantra.english}</span>
          </p>
        ))}
        <p class="mt-4 text-gray-600 italic">{HOME_PAGE.objective.closingText}</p>
      </div>
    </div>
  </Section>

  <!-- TTC Courses Section -->
  <Section title="Our Yoga Teacher Training Courses" bgColor="bg-gray-50">
    <div class="grid md:grid-cols-3 gap-8">
      {HOME_PAGE.ttcCourses.map((course) => (
        <Card
          title={course.title}
          description={course.description}
          image={course.image}
          href={course.url}
          buttonText={course.buttonText}
        />
      ))}
    </div>
  </Section>

  <!-- Certifications Section -->
  <Section title={HOME_PAGE.certifications.title} bgColor="bg-white">
    <div class="max-w-4xl mx-auto space-y-4">
      {HOME_PAGE.certifications.paragraphs.map((paragraph) => (
        <p class="text-gray-700 leading-relaxed text-justify">{paragraph}</p>
      ))}
    </div>
  </Section>

  <!-- Founder Section -->
  <Section title={HOME_PAGE.founder.title} bgColor="bg-gray-50">
    <div class="max-w-4xl mx-auto">
      <p class="text-gray-700 leading-relaxed text-justify mb-6">
        {HOME_PAGE.founder.intro}
      </p>

      <!-- Founder Images -->
      <div class="grid grid-cols-3 gap-4 my-8">
        {HOME_PAGE.founder.images.map((img) => (
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-auto rounded-lg shadow-md"
            loading="lazy"
          />
        ))}
      </div>

      {HOME_PAGE.founder.paragraphs.map((paragraph) => (
        <p class="text-gray-700 leading-relaxed text-justify mb-4">{paragraph}</p>
      ))}

      <!-- Awards -->
      <div class="grid md:grid-cols-2 gap-4 mt-8">
        {HOME_PAGE.founder.awards.map((award) => (
          <div class={`${award.bgColor} p-4 rounded-lg flex items-center`}>
            <span class="text-3xl mr-4">{award.icon}</span>
            <span class="text-sm font-semibold text-gray-800">{award.title}</span>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <!-- YTT Course Section -->
  <YTTCourseSection />

  <!-- Yoga Alliance -->
  <YogaAllianceRegisteredSchool />

  <!-- Reviews -->
  <ReviewSection />

  <!-- Teachers Section -->
  <Section title={HOME_PAGE.teachers.title} bgColor="bg-gray-50">
    <div class="max-w-4xl mx-auto mb-8">
      <p class="text-gray-700 leading-relaxed text-center mb-4">
        {HOME_PAGE.teachers.intro}
      </p>
      <p class="text-purple-600 font-semibold text-center">
        ✨ {HOME_PAGE.teachers.didYouKnow}
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {HOME_PAGE.teachers.list.map((teacher) => (
        <div class="bg-white rounded-lg shadow-lg overflow-hidden">
          <img
            src={teacher.image}
            alt={teacher.name}
            class="w-full h-48 object-cover"
            loading="lazy"
          />
          <div class="p-4">
            <h3 class="font-bold text-lg mb-2">{teacher.name}</h3>
            <p class="text-sm text-gray-600 mb-1">{teacher.specialty}</p>
            <p class="text-sm text-purple-600 font-semibold">{teacher.experience}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- Facilities Section -->
  <Section title={HOME_PAGE.facilities.title} bgColor="bg-white">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {HOME_PAGE.facilities.cards.map((facility) => (
        <Card
          title={facility.title}
          description={facility.description}
          image={facility.image}
        />
      ))}
    </div>
  </Section>

  <!-- FAQ Section -->
  <FAQFlipSection client:load />

  <!-- Location Section -->
  <LocationSection />
</Layout>
