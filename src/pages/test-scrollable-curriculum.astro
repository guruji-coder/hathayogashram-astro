---
import Layout from '../components/layout/Layout.astro';
import ScrollableCurriculumSection from '../components/sections/TTC/ScrollableCurriculumSection.astro';
import { TRAINING_200_CURRICULUM_SECTION } from '$constants/pages/ttc/200hour';

const title = 'Scrollable Curriculum Test - Hatha Yoga Ashram';
const description = 'Test page for the new scrollable curriculum component with background images that change on scroll';
---

<Layout description={description} title={title}>
  <main>
    <!-- Test the new scrollable curriculum component -->
    <ScrollableCurriculumSection curriculumData={TRAINING_200_CURRICULUM_SECTION} />
  </main>
</Layout>

<style>
  /* Ensure smooth scrolling for the entire page */
  html {
    scroll-behavior: smooth;
  }
  
  /* Remove default margins */
  body {
    margin: 0;
    padding: 0;
  }
</style>
