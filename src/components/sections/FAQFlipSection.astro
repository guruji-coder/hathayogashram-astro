---
import FaqCard from '$ui/FaqCard.astro';
import { FAQ_FLIP_CARDS } from '$constants/pages/home/faq';
import SectionHeader from '$ui/SectionHeader.astro';

interface FaqData {
  id: number;
  question: string;
  answer: string;
}

interface OriginalFaqData {
  question: string;
  answer: string;
  category: string;
}

interface FaqSectionData {
  TITLE: string;
  FAQS: FaqData[];
  CTA: {
    SUBTITLE: string;
    BUTTON_TEXT: string;
    LINK: string;
  };
}

interface Props {
  title?: string;
  subtitle?: string;
  faqData?: FaqSectionData;
}

const { 
  title = "Frequently Asked Questions", 
  subtitle = "Get answers to common questions about our yoga teacher training programs",
  faqData
} = Astro.props;

// Use faqData if provided, otherwise fallback to default FAQ_FLIP_CARDS
const faqs = faqData ? faqData.FAQS : FAQ_FLIP_CARDS;
const sectionTitle = faqData ? faqData.TITLE : title;
const ctaData = faqData?.CTA || {
  SUBTITLE: "Still have questions? We'd love to help!",
  BUTTON_TEXT: "Contact Us",
  LINK: "/contact"
};
---

<section class="py-16 bg-gradient-to-br from-purple-50 to-indigo-50">
  <div class="container mx-auto px-4">
  
    <SectionHeader title={sectionTitle} />

    <!-- FAQ Cards Grid -->
    <div class="faq-grid grid gap-3 md:gap-4 lg:gap-6">
      {faqs.map((faq, index) => (
        <div class:list={[{ 'hidden-mobile': index >= 4 }]}>
          <FaqCard
            answer={faq.answer}
            category={('category' in faq) ? (faq as any).category : ''}
            question={faq.question}
          />
        </div>
      ))}
    </div>

    <!-- Mobile Read More Button -->
    <div class="text-center mt-8 md:hidden">
      <button 
        class="bg-purple-600 text-white px-6 py-2 rounded-full font-medium hover:bg-purple-700 transition-colors"
        id="read-more-btn"
        onclick="document.querySelectorAll('.hidden-mobile').forEach(card => card.classList.remove('hidden-mobile')); this.style.display='none';"
      >
        Read More FAQs
      </button>
    </div>

    <!-- Call to Action -->
    <div class="text-center mt-12">
      <p class="text-lg text-gray-700 mb-6">{ctaData.SUBTITLE}</p>
      <a class="inline-block bg-gradient-to-r from-purple-600 to-indigo-600 text-white px-8 py-3 rounded-full font-semibold hover:from-purple-700 hover:to-indigo-700 transition-all duration-300 transform hover:scale-105 shadow-lg hover:shadow-xl" href={ctaData.LINK}>
        {ctaData.BUTTON_TEXT}
      </a>
    </div>

  </div>
</section>

<style>
  /* Responsive Grid Layout */
  .faq-grid {
    /* Mobile: 1 column */
    grid-template-columns: 1fr;
  }
  
  /* Tablet: 3x3 grid */
  @media (min-width: 768px) {
    .faq-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  
  /* Desktop: 4x4 grid */
  @media (min-width: 1024px) {
    .faq-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Hide cards after 4th on mobile only */
  @media (max-width: 767px) {
    .hidden-mobile {
      display: none;
    }
  }
</style>
