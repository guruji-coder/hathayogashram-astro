---
import { BUTTON_STYLES } from '$constants/uiConstants';
import SectionHeader from '$components/ui/SectionHeader.astro';

interface Props {
  section: typeof import('$constants/HomePage/homePageConstants').CERTIFICATIONS_SECTION;
  styles: typeof import('$constants/HomePage/homePageConstants').HOME_STYLES;
}

const { section, styles } = Astro.props as Props;
---

<!-- Certifications & Accreditations Section -->
<section class:list={[`${styles.SECTION_PADDING}`, `bg-white`]}>
  <div class:list={styles.CONTAINER}>
    <!-- Section Header -->
    <SectionHeader title={section.TITLE} />

    <!-- Content Paragraphs -->
    <div class="mx-auto mb-12 max-w-full space-y-6">
      {
        section.PARAGRAPHS.slice(0, 4).map((paragraph: string) => (
          <p class:list={`${styles.CERTIFICATION_PARAGRAPH}`}>{paragraph}</p>
        ))
      }

      <!-- Yoga Alliance Logo after Guru-Shishya tradition paragraph -->
      <div class="my-8 flex justify-center">
        <div class="transition-transform duration-300 hover:scale-105">
          <img
            alt="Yoga Alliance Registered School Logo"
            class=""
            loading="lazy"
            src="/yoga-alliance-logo.png"
          />
        </div>
      </div>

      <!-- Remaining paragraphs after the logo -->
      {
        section.PARAGRAPHS.slice(4).map((paragraph: string) => (
          <p class:list={`${styles.CERTIFICATION_PARAGRAPH}`}>{paragraph}</p>
        ))
      }
    </div>
  </div>
</section>
