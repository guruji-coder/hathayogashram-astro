---
import type {
  HOME_HERO,
  HOME_HIGHLIGHTS,
  HOME_CONTENT,
  HOME_GALLERY,
  HOME_COURSES,
  HOME_STYLES,
} from '$constants/pages/home';

interface Props {
  hero: typeof HOME_HERO;
  highlights: typeof HOME_HIGHLIGHTS;
  content: typeof HOME_CONTENT;
  gallery: typeof HOME_GALLERY;
  courses: typeof HOME_COURSES;
  styles: typeof HOME_STYLES;
}

const { hero, highlights, content, gallery, courses, styles } = Astro.props as Props;
import { BUTTON_STYLES } from '$constants/shared/ui';
import SectionHeader from '$ui/SectionHeader.astro';
---

<!-- Welcome Section with Decorative Styling -->
<section class:list={[`${styles.SECTION_PADDING}`, `bg-white`]}>
  <div class:list={styles.CONTAINER}>
    <!-- Main Heading with Decorative Underline -->
    <SectionHeader
      containerClass="mb-8 text-center"
      svgHeight={20}
      svgWidth={200}
      title={hero.TITLE}
      titleClass={styles.HERO_TITLE}
    />

    <!-- Rating and Welcome Message -->
    <div class="mb-8 text-center">
      <div class="mb-4 flex items-center justify-center">
        <span class:list={styles.RATING_NUMBER}>{hero.RATING.STARS}</span>
        <i class="fas fa-star mr-2 text-xl text-yellow-400"></i>
        <span class:list={styles.RATING_TEXT}>{hero.RATING.TEXT}</span>
      </div>
      <p class:list={styles.HERO_SUBTITLE}>
        {hero.SUBTITLE}
      </p>
    </div>

    <!-- Highlight Boxes Grid -->
    <div class:list={styles.HIGHLIGHT_GRID}>
      {
        highlights.map(highlight => (
          <div class:list={styles.HIGHLIGHT_BOX}>
            <i class:list={[`${highlight.ICON}`, `${styles.HIGHLIGHT_ICON}`]} />
            <p class:list={styles.HIGHLIGHT_TEXT}>{highlight.TEXT}</p>
          </div>
        ))
      }
    </div>

    <!-- Intro Paragraph -->
    <div class="mx-auto max-w-full">
      <p class:list={styles.INTRO_PARAGRAPH}>
        {content.INTRO_PARAGRAPH}
      </p>
    </div>

    <!-- Two Column Layout: Content + Images -->
    <div class="mx-auto max-w-full">
      <div class:list={styles.TWO_COLUMN_GRID}>
        <!-- Left Column: Description Paragraphs -->
        <div class:list={styles.CONTENT_CONTAINER}>
          <!-- First Paragraph -->
          <p class:list={styles.CONTENT_PARAGRAPH}>
            {content.PARAGRAPHS[0]}
          </p>

          <!-- Mobile Images (shown after first paragraph on mobile only) -->
          <div class:list={[`lg:hidden`, `${styles.IMAGE_GRID}`, `mb-6`]}>
            {
              gallery.IMAGES.map((image, index) => (
                <div class:list={styles.IMAGE_ITEM}>
                  <img
                    alt={`${gallery.ALT_TEXT} - Image ${index + 1}`}
                    class:list={styles.IMAGE_STYLING}
                    loading="lazy"
                    src={image}
                  />
                </div>
              ))
            }
          </div>

          <!-- Remaining Paragraphs -->
          {
            content.PARAGRAPHS.slice(1).map(paragraph => (
              <p class:list={styles.CONTENT_PARAGRAPH}>{paragraph}</p>
            ))
          }

          <!-- Course Buttons -->
          <div class:list={styles.COURSE_BUTTONS_CONTAINER}>
            {
              courses.map(course => (
                <a
                  class:list={[`${BUTTON_STYLES.BASE}`, `${BUTTON_STYLES.VARIANTS.PRIMARY}`]}
                  href={course.URL}
                >
                  {course.TITLE}
                </a>
              ))
            }
          </div>
        </div>

        <!-- Right Column: Image Gallery (desktop only) -->
        <div class="hidden lg:block">
          <div class:list={styles.IMAGE_GRID}>
            {
              gallery.IMAGES.map((image, index) => (
                <div class:list={styles.IMAGE_ITEM}>
                  <img
                    alt={`${gallery.ALT_TEXT} - Image ${index + 1}`}
                    class:list={styles.IMAGE_STYLING}
                    loading="lazy"
                    src={image}
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
