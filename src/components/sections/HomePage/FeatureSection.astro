---
import { HOME_STYLES, FOUNDER_SECTION } from '$constants/HomePage/homePageConstants';
import SectionHeader from '$ui/SectionHeader.astro';
import FounderImages from '$features/founder/FounderImages.astro';
import FounderInfo from '$features/founder/FounderInfo.astro';
import FounderAwards from '$features/founder/FounderAwards.astro';

interface Props {
  styles: typeof HOME_STYLES;
  section: typeof FOUNDER_SECTION;
}

const { styles, section } = Astro.props as Props;
---

<section class:list={[`${styles.SECTION_PADDING}`, `bg-white`]}>
  <div class:list={styles.CONTAINER}>
    <!-- Section Header -->
    <SectionHeader
      containerClass="mb-12 text-center"
      svgHeight={20}
      svgWidth={200}
      title={section.TITLE}
    />

    <!-- Main Content Layout -->
    <div class="mx-10 max-w-full text-[15px]">
      <p>
        {section.INTRO_TEXT}
      </p>

      <div class="my-10 flex flex-col gap-8 lg:flex-row lg:gap-12">
        <!-- Left Column: Images -->
        <FounderImages />

        <!-- Right Column: Content -->
        <FounderInfo />
      </div>
    </div>

    <!-- Awards & Honours Section -->
    <FounderAwards />
  </div>
</section>
