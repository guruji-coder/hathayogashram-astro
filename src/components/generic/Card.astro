---
/**
 * Generic Card Component
 * 
 * Reusable card for displaying content with optional image, icon, title, and description.
 */

interface Props {
  title: string;
  description?: string;
  icon?: string;
  image?: string;
  href?: string;
  buttonText?: string;
}

const { title, description, icon, image, href, buttonText } = Astro.props;
---

<div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow duration-300">
  {icon && (
    <div class="mb-4">
      <i class={`${icon} text-4xl text-purple-600`}></i>
    </div>
  )}
  
  {image && (
    <img 
      src={image} 
      alt={title} 
      class="w-full h-48 object-cover rounded-lg mb-4"
      loading="lazy"
    />
  )}
  
  <h3 class="text-xl font-bold mb-3 text-gray-800">{title}</h3>
  
  {description && (
    <p class="text-gray-600 leading-relaxed mb-4">{description}</p>
  )}
  
  <slot />
  
  {href && buttonText && (
    <a 
      href={href} 
      class="inline-block mt-4 px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors"
    >
      {buttonText}
    </a>
  )}
</div>
