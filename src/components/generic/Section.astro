---
/**
 * Generic Section Component
 * 
 * Reusable wrapper for page sections with consistent styling.
 * Replaces dozens of specialized section components.
 */

interface Props {
  title?: string;
  subtitle?: string;
  bgColor?: string;
  textColor?: string;
  padding?: string;
  id?: string;
  containerClass?: string;
}

const {
  title,
  subtitle,
  bgColor = 'bg-white',
  textColor = 'text-gray-800',
  padding = 'py-12 md:py-20',
  id,
  containerClass = 'container mx-auto px-4',
} = Astro.props;
---

<section class={`${padding} ${bgColor}`} id={id}>
  <div class={containerClass}>
    {title && (
      <h2 class={`text-3xl md:text-4xl font-bold text-center mb-4 ${textColor}`}>
        {title}
      </h2>
    )}
    {subtitle && (
      <p class="text-lg md:text-xl text-center mb-8 md:mb-12 text-gray-600">
        {subtitle}
      </p>
    )}
    <slot />
  </div>
</section>
